# Ambiente: mostra i dettagli degli errori solo se APP_DEBUG=true
APP_DEBUG=false

# URL pubblico (senza slash finale). Se vuoto viene dedotto dalla richiesta.
APP_URL=

# Limiti di upload (ricordati di allineare upload_max_filesize e post_max_size in php.ini)
MAX_FILE_SIZE_MB=100

# Scadenza dei file, in ore
DEFAULT_EXPIRY_HOURS=24
MAX_EXPIRY_HOURS=720

# Lunghezza del codice di condivisione (es. 5 => 8Kf2a)
CODE_LENGTH=5

# Percorsi (relativi alla root del progetto o assoluti)
DB_PATH=storage/filedrop.sqlite
STORAGE_PATH=storage

# Probabilità (0-1) di eseguire la pulizia dei file scaduti a ogni richiesta.
# In produzione è meglio usare un cron con: php bin/cleanup.php
CLEANUP_PROBABILITY=0.02

# Admin Password
ADMIN_PASSWORD_HASH=